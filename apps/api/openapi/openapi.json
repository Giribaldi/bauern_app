    "/v1/farms/nearby": {
      "get": {
        "operationId": "findNearbyFarms",
        "tags": ["farms"],
        "parameters": [
          {
            "schema": {
              "minimum": -90,
              "maximum": 90,
              "type": "number"
            },
            "in": "query",
            "name": "latitude",
            "required": true
          },
          {
            "schema": {
              "minimum": -180,
              "maximum": 180,
              "type": "number"
            },
            "in": "query",
            "name": "longitude",
            "required": true
          },
          {
            "schema": {
              "exclusiveMinimum": 0,
              "maximum": 100,
              "default": 20,
              "type": "number"
            },
            "in": "query",
            "name": "radiusKm",
            "required": false
          },
          {
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "enum": ["fruit"]
                },
                {
                  "type": "string",
                  "enum": ["vegetable"]
                },
                {
                  "type": "string",
                  "enum": ["herb"]
                },
                {
                  "type": "string",
                  "enum": ["other"]
                }
              ]
            },
            "in": "query",
            "name": "category",
            "required": false
          },
          {
            "schema": {
              "default": true,
              "type": "boolean"
            },
            "in": "query",
            "name": "availableOnly",
            "required": false
          },
          {
            "schema": {
              "minimum": 1,
              "maximum": 50,
              "default": 20,
              "type": "integer"
            },
            "in": "query",
            "name": "limit",
            "required": false
          },
          {
            "schema": {
              "pattern": "^[0-9]+$",
              "maxLength": 10,
              "type": "string"
            },
            "in": "query",
            "name": "cursor",
            "required": false
          }
        ],
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "farms": {
                      "type": "array",
