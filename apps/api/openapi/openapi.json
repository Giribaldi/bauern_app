                      "items": {}
                    }
                  },
                  "required": ["type", "title", "status", "code", "detail", "requestId", "errors"]
                }
              }
            }
          },
          "500": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "type": {
                      "format": "uri",
